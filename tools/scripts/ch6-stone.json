  {"wait": 1200},

  {"slots": [[1, "KNOT"], [2, "CROWN"], [3, "ASH"], [4, "WELL"], [5, "VEIL"], [6, "EMBER"], [7, "ASH"], [8, "COLD"]]},
  {"clickText": "Read the stone"}, {"wait": 1200}, {"keys": "acm/"}, {"wait": 1800}, {"key": "Space"}, {"wait": 400},
  {"expect": "The fire is the hollow they left."}, {"shot": "s_solved"},
  {"assert": "window.VigilStore.state.flags.WALK_UNLOCKED === true && window.VigilStore.state.flags.LAW0 === true"},
  {"eval": "({ CRACKED: window.VigilStore.state.flags.BELLS_CRACKED, MISREAD: window.VigilStore.state.flags.STONE_MISREAD, WALK: window.VigilStore.state.flags.WALK_UNLOCKED })"},
  {"clickText": "What it means"}, {"wait": 800}, {"key": "Space"}, {"expect": "THE FOURFOLD WALK IS OPEN"}
